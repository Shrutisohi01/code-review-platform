# Server-side only. Never prefix with NEXT_PUBLIC_. Put real values in .env.local (Git-ignored)
# or in your host's secret settings. Placeholders only in this file.

# --- JEV ---
JEV_AI_API_KEY=your-jev-api-key-here
JEV_API_BASE_URL=https://jev-ai.pro/api
JEV_MODEL_NAME=jev-latest

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Required. Example: claude-sonnet-5-5 (see README "Choosing a model").
ANTHROPIC_MODEL=claude-sonnet-5-5
# Kill switch: set to false to disable all Claude calls immediately (JEV-only keeps working).
CLAUDE_ANALYSIS_ENABLED=true
# low | medium | high | xhigh | max | default (API default). Lower = fewer thinking tokens.
ANTHROPIC_EFFORT=medium
# Hard limits per review
CLAUDE_MAX_REQUESTS_PER_REVIEW=4
CLAUDE_MAX_BUDGET_USD_PER_REVIEW=0.25
CLAUDE_MAX_OUTPUT_TOKENS=6000
CLAUDE_MAX_CONTEXT_CHARS=40000
CLAUDE_MAX_CANDIDATES_PER_REQUEST=8
CLAUDE_CONTEXT_LINES=12
CLAUDE_CONCURRENCY=2
CLAUDE_TIMEOUT_MS=60000
# Only needed for models not in the built-in price table (USD per million tokens); also overrides it.
# ANTHROPIC_INPUT_PRICE_PER_MTOK=
# ANTHROPIC_OUTPUT_PRICE_PER_MTOK=

# --- Access control / abuse protection ---
# Shared secret required by /api/reviews (sent as "Authorization: Bearer ..."). Generate a long random value.
# In production the API refuses to run without it unless ALLOW_UNAUTHENTICATED=true.
REVIEW_ACCESS_TOKEN=
# ALLOW_UNAUTHENTICATED=false
# Per-instance daily cap on Claude requests, and duplicate-submission replay window
REVIEW_DAILY_CLAUDE_REQUEST_CAP=200
REVIEW_DEDUPE_TTL_SEC=600
